  "private": true,
  "description": "Bloom API: accounts, goals, Bloom Agent (policy-bound session key), risk engine, claim links, learning",
  "type": "module",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "dev": "node --watch src/index.ts",
