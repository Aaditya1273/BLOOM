{
  "name": "bloom",
  "version": "1.0.0",
  "description": "Bloom — the wallet where dollars become assets and actions. Consumer finance on Robinhood Chain with a Stylus equity-aware risk engine.",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:stylus": "cd stylus-risk-engine && ~/.cargo/bin/cargo test",
    "vectors": "node scripts/gen-risk-vectors.js",
    "abis": "hardhat compile && node scripts/export-abis.js",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network robinhoodTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network robinhoodMainnet",
    "preflight:mainnet": "hardhat run scripts/preflight-mainnet.js --network hardhat",
    "test:fuzz": "forge test",
    "test:all": "hardhat test && forge test && npm run test:stylus"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@account-abstraction/contracts": "^0.8.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.28.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "solc": "^0.8.35"
  }
}
