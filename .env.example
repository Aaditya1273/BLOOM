# ============================================================
# Bloom environment variables. Copy to .env.local (gitignored). NEVER commit real keys.
#
# KEY SEPARATION: every role has its own variable and key. There is no fallback between roles and no generic
# PRIVATE_KEY. Generate distinct keys with:  node scripts/generate-role-keys.js
# Only on a LOCAL Hardhat chain (31337) do unset keys fall back to the PUBLIC Hardhat dev accounts.
#
# Which process needs which key:
#   deploy scripts : DEPLOYER_PRIVATE_KEY (+ ADMIN_PRIVATE_KEY to accept ownership, or ADMIN_ADDRESS for a Safe)
#   backend        : REPORTER, AGENT, CLAIM_AUTHORITY (+ testnet: FAUCET, MOCK_ORACLE, optional DEMO_OWNER)
#   NEVER give the backend DEPLOYER_PRIVATE_KEY or ADMIN_PRIVATE_KEY in a hosted environment.
# ============================================================

# ── Networks ──
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC_URL=
# RPC_URL=                        # optional override for backend/reporter
BLOOM_DEPLOYMENT=localhost        # reads deployments/<name>.json (localhost | robinhood-testnet | robinhood-mainnet)

# ── Deployment only (scripts/deploy.js, scripts/deploy-stylus.js, scripts/rotate-roles.js) ──
DEPLOYER_PRIVATE_KEY=             # deploys contracts, then hands every role over and keeps none
ADMIN_PRIVATE_KEY=                # testnet admin EOA (accepts ownership). Production: use ADMIN_ADDRESS = a Safe
# ADMIN_ADDRESS=                  # admin by address only (multisig); ownership stays pending until the Safe accepts
BLOOM_RISK_ENGINE_ADDRESS=        # deployed Stylus risk engine (required on mainnet unless ALLOW_EVM_RISK_ENGINE)
ALLOW_EVM_RISK_ENGINE=false
MAINNET_DEPLOY=false
MAINNET_DEPLOY_CONFIRM=           # must be YES_I_UNDERSTAND to deploy on 4663
MAINNET_MAX_DEPLOYMENT_USD=0.01   # deployment stops if the preflight estimate is >= this; raise explicitly

# ── Backend role keys (each distinct; the backend refuses to start if two roles share a key) ──
REPORTER_PRIVATE_KEY=             # risk engine reporter allowlist only: signs EIP-712 market reports
AGENT_PRIVATE_KEY=                # Bloom Agent session key: acts only inside each goal's onchain BloomPolicy
CLAIM_AUTHORITY_PRIVATE_KEY=      # BloomClaims claim authorization only (+ relays the claim tx)
FAUCET_PRIVATE_KEY=               # testnet only: MockUSDG MINTER_ROLE (+ sponsors Bloom account creation gas)
MOCK_ORACLE_PRIVATE_KEY=          # testnet only: FEED_ADMIN on mock feeds/sequencer, CORP_ACTION on mock Stock Tokens
DEMO_OWNER_PRIVATE_KEY=           # testnet only, optional: owner of a demo Bloom account (smoke scripts)

# ── Reporter ──
REPORTER_ENABLED=true             # run the halt-aware reporter inside the backend (default true except mainnet)
REPORTER_INTERVAL_SEC=120         # testnet default 120s (30s on local)
CORP_ACTION_WINDOW_SEC=86400      # pause when a multiplier change / corporate action lands within this window
# RH_API_BASE=https://api.robinhood.com/rhj

# ── Backend HTTP / auth ──
PORT=3001
NODE_ENV=development              # production: requires an explicit FRONTEND_ORIGIN (no wildcard)
FRONTEND_ORIGIN=http://localhost:3000   # CORS allowlist (comma-separated exact origins)
# AUTH_URI=https://app.example    # origin wallet sign-ins are bound to (defaults to the first FRONTEND_ORIGIN)
# ADMIN_ADDRESSES=0x...,0x...     # extra admin wallets (BloomVault DEFAULT_ADMIN_ROLE holders are always admins)
# SESSION_TTL_SEC=3600            # signed-in session lifetime
# FAUCET_DAILY_CAP=100            # testnet faucet: max mints per day across all wallets (1/day/wallet)
# TRUST_PROXY=1                   # set behind a reverse proxy so rate limits see the real client IP
# BLOOM_DATA_DIR=backend/data     # runtime JSON store
# ACTIVITY_LOOKBACK_BLOCKS=50000
# PUBLIC_API_URL=https://api.example   # used in ERC-8004 agent metadata

# ── Optional LLM fallback for unrecognised chat phrasing (OpenAI-compatible) ──
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Optional ERC-8004 identity (registry maintained by the ERC-8004 team, not Robinhood) ──
ERC8004_IDENTITY_REGISTRY=        # testnet: 0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_RPC_URL=
ERC8004_OWNER_PRIVATE_KEY=
ERC8004_AGENT_ID=

# ── Frontend (only these PUBLIC values are read by the frontend; never secrets) ──
NEXT_PUBLIC_API_URL=              # empty in production = same-origin /api; dev default http://localhost:3001
WALLET_CONNECT_PROJECT_ID=        # Reown / WalletConnect project id for RainbowKit (public)
NEXT_PUBLIC_CHAIN_ID=46630        # 46630 Robinhood Chain Testnet, or 31337 for a local Hardhat node
