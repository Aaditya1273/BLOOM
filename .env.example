# ============================================================
# Bloom — environment variables (copy to .env). NEVER commit real keys.
# On a LOCAL Hardhat chain (31337) every key below falls back to the public Hardhat dev accounts:
#   #0 deployer/admin/feed admin/minter, #1 reporter, #2 claim authority, #5 demo owner, #6 agent session key.
# Those fallbacks are never used on any other chain.
# ============================================================

# ── Networks ──
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC_URL=
# RPC_URL=                        # optional override for backend/reporter
BLOOM_DEPLOYMENT=localhost        # reads deployments/<name>.json (localhost | robinhood-testnet | robinhood-mainnet)

# ── Deployment (scripts/deploy.js) ──
DEPLOYER_PRIVATE_KEY=
BLOOM_RISK_ENGINE_ADDRESS=        # deployed Stylus risk engine (required on mainnet unless ALLOW_EVM_RISK_ENGINE)
ALLOW_EVM_RISK_ENGINE=false
MAINNET_DEPLOY=false
MAINNET_DEPLOY_CONFIRM=           # must be YES_I_UNDERSTAND to deploy on 4663
MAINNET_MAX_DEPLOYMENT_USD=0.01      # deployment stops if the preflight estimate is >= this; raise explicitly

# ── Operational keys ──
REPORTER_PRIVATE_KEY=             # signs EIP-712 MarketReports (allowlisted in the risk engine)
CLAIM_AUTHORITY_PRIVATE_KEY=      # signs BloomClaims ClaimAuthorization for verified claim-link recipients
AGENT_SESSION_PRIVATE_KEY=        # Bloom Agent session key: only useful inside onchain BloomPolicy limits; needs gas
FEED_ADMIN_PRIVATE_KEY=           # testnet only: writes mock price feeds / scenarios (defaults to DEPLOYER_PRIVATE_KEY)
MINTER_PRIVATE_KEY=               # testnet only: faucet + learning rewards (defaults to DEPLOYER_PRIVATE_KEY)
DEMO_OWNER_PRIVATE_KEY=           # testnet only: owner EOA of the demo BloomAccount (refused on chain 4663); needs gas

# ── Reporter ──
REPORTER_ENABLED=true             # run the halt-aware reporter inside the backend (default true except mainnet)
REPORTER_INTERVAL_SEC=30
CORP_ACTION_WINDOW_SEC=86400      # pause when a multiplier change / corporate action lands within this window
# RH_API_BASE=https://api.robinhood.com/rhj

# ── Backend ──
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000   # CORS allowlist (comma-separated)
# BLOOM_DATA_DIR=backend/data           # runtime JSON store
# ACTIVITY_LOOKBACK_BLOCKS=50000
# PUBLIC_API_URL=http://localhost:3001  # used in ERC-8004 agent metadata

# ── Optional LLM fallback for unrecognised chat phrasing (OpenAI-compatible) ──
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Optional ERC-8004 identity (registry maintained by the ERC-8004 team, not Robinhood) ──
ERC8004_IDENTITY_REGISTRY=        # testnet: 0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_RPC_URL=
ERC8004_OWNER_PRIVATE_KEY=
ERC8004_AGENT_ID=

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:3001
